---
// JUEGO 2: la playa y el mar (dos velocidades).
// Es igual que la cancha, pero el tablero está partido en dos: en la arena
// se corre rápido y en el mar se nada más lento. El punto se escoge en la orilla.
import Layout from '../layouts/Layout.astro';
import MarcoJuego from '../components/MarcoJuego.astro';
import EscenaPlaya from '../components/EscenaPlaya.astro';
import { PLAYA } from '../scripts/escenarios.js';

// Aquí el tablero ocupa todo el dibujo, sin márgenes
const caja = { x: 0, y: 0, ancho: PLAYA.ancho, alto: PLAYA.alto };

const pasos = [
  'Jugador 1: arrastra sobre la orilla (la línea amarilla) para escoger por dónde te metes al mar. Queda en secreto.',
  'Jugador 2: escoge el tuyo. Al confirmar empieza la cuenta regresiva.',
  'En la arena corren rápido y en el mar nadan lento. Gana el que llegue primero al salvavidas.',
];
---

<Layout titulo="Playa y mar" descripcion="Juego 2: correr por la arena, nadar por el mar y llegar primero.">
  <MarcoJuego
    escenario={PLAYA}
    numero="02"
    etiqueta="Dos velocidades"
    titulo="Playa y mar"
    descripcion="Salen de la torre, corren por la arena, se meten al mar por el punto que escogieron y nadan hasta el salvavidas. Ojo: el camino más corto no siempre es el más rápido."
    caja={caja}
    dyEtiqueta={4.2}
    ladoEtiqueta
    textoAlterno="Playa vista desde arriba: arena en la mitad de arriba y mar en la de abajo. Los jugadores salen de la esquina superior izquierda, cruzan la orilla por el punto elegido y nadan hasta un salvavidas."
    pasos={pasos}
  >
    <EscenaPlaya />
  </MarcoJuego>
</Layout>
