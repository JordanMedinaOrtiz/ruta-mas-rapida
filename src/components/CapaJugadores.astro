---
// Esta capa va DENTRO del <svg> de cada tablero y trae todo lo que se
// mueve: las rutas, los marcadores sobre la línea, las fichas de los
// jugadores y los efectos. La hicimos componente para no repetir lo
// mismo en la cancha y en la playa.
//
// Aquí solo se "dibujan" las piezas, quien las mueve es src/scripts/juego.js,
// que las encuentra por sus atributos data-*.
//
// dyEtiqueta   = qué tan abajo de la línea va la etiqueta con los metros
// ladoEtiqueta = si la etiqueta se pone a un lado del punto en vez de centrada
const { escenario, dyEtiqueta = 6, ladoEtiqueta = false } = Astro.props;

const jugadores = [1, 2];
const mitad = (escenario.xMin + escenario.xMax) / 2;

// Clases de color de cada jugador (las escribimos completas para que
// Tailwind las detecte y las genere)
const relleno: Record<number, string> = { 1: "fill-j1", 2: "fill-j2" };
const trazo: Record<number, string> = { 1: "stroke-j1", 2: "stroke-j2" };
---

<g>
  {
    jugadores.map((j) => (
      <>
        {/* Vista previa punteada de la ruta mientras se escoge el punto */}
        <polyline
          data-previa={j}
          fill="none"
          class="stroke-tinta"
          stroke-width="0.45"
          stroke-dasharray="1.4 1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.75"
          visibility="hidden"
        />
        {/* Estela: el camino que ya recorrió. Va doble (blanco abajo y color arriba)
            para que se distinga igual sobre el pasto, la arena o el mar */}
        <polyline
          data-estela-borde={j}
          fill="none"
          stroke="white"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.9"
        />
        <polyline
          data-estela={j}
          fill="none"
          class={trazo[j]}
          stroke-width="0.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </>
    ))
  }

  <!-- Ruta óptima (se revela al final si la piden). Son dos líneas encimadas:
       una negra abajo y la dorada punteada arriba, para que resalte en cualquier fondo -->
  <polyline
    data-optima
    fill="none"
    class="stroke-tinta"
    stroke-width="1.25"
    stroke-linecap="round"
    stroke-linejoin="round"
    visibility="hidden"></polyline>
  <polyline
    data-optima
    fill="none"
    class="stroke-oro"
    stroke-width="0.65"
    stroke-dasharray="2 1.5"
    stroke-linejoin="round"
    visibility="hidden"></polyline>

  <!-- Marcadores: el punto que cada jugador escoge sobre la línea -->
  {
    jugadores.map((j) => (
      <g
        data-marcador={j}
        transform={`translate(${mitad} ${escenario.lineaY})`}
        visibility="hidden"
      >
        <circle data-halo={j} r="1.7" class={relleno[j]} opacity="0.4" />
        <circle r="1.3" class={relleno[j]} stroke="white" stroke-width="0.45" />
        {/* Pildorita con los metros, para ver el número junto al punto */}
        <g
          data-pildora={j}
          data-dy={dyEtiqueta}
          data-dx={ladoEtiqueta ? 7.8 : 0}
          transform={`translate(0 ${dyEtiqueta})`}
        >
          <rect
            x="-6"
            y="-1.9"
            width="12"
            height="3.8"
            rx="1.9"
            class="fill-tinta"
          />
          <text
            data-pildora-texto={j}
            y="0.1"
            text-anchor="middle"
            dominant-baseline="central"
            font-size="2.1"
            class="fill-papel font-mono font-bold"
          >
            {mitad.toFixed(1)} m
          </text>
        </g>
      </g>
    ))
  }

  <!-- Marca del punto óptimo -->
  <g
    data-optima-marca
    transform={`translate(${mitad} ${escenario.lineaY})`}
    visibility="hidden"
  >
    <rect
      x="-1.3"
      y="-1.3"
      width="2.6"
      height="2.6"
      transform="rotate(45)"
      class="fill-oro stroke-tinta"
      stroke-width="0.45"></rect>
    <g
      data-optima-pildora
      data-dy={dyEtiqueta}
      data-dx={ladoEtiqueta ? 11.3 : 0}
      transform={`translate(0 ${dyEtiqueta})`}
    >
      <rect
        x="-9.5"
        y="-1.9"
        width="19"
        height="3.8"
        rx="1.9"
        class="fill-oro stroke-tinta"
        stroke-width="0.3"></rect>
      <text
        data-optima-texto
        y="0.1"
        text-anchor="middle"
        dominant-baseline="central"
        font-size="2.1"
        class="fill-tinta font-mono font-bold">ÓPTIMO</text
      >
    </g>
  </g>

  <!-- Fichas de los jugadores. Van en 3 grupos anidados para animar cada cosa por separado:
       ficha   = posición sobre la ruta
       abanico = el pequeño desfase para que no se tapen en la salida
       cuerpo  = el "rebote" al correr -->
  <g data-fichas>
    {
      jugadores.map((j) => (
        <g
          data-ficha={j}
          transform={`translate(${escenario.inicio.x} ${escenario.inicio.y})`}
        >
          <g data-abanico={j}>
            <g data-cuerpo={j}>
              <ellipse
                cx="0.35"
                cy="0.6"
                rx="2.35"
                ry="2.25"
                class="fill-tinta"
                opacity="0.28"
              />
              <circle
                r="2.3"
                class={relleno[j]}
                stroke="white"
                stroke-width="0.55"
              />
              <text
                y="0.15"
                text-anchor="middle"
                dominant-baseline="central"
                font-size="3"
                class="fill-white font-display font-black"
              >
                {j}
              </text>
            </g>
          </g>
        </g>
      ))
    }
  </g>

  <!-- Aquí JavaScript mete las ondas y el confeti -->
  <g data-efectos></g>

  <!-- Cuenta regresiva 3, 2, 1... -->
  <text
    data-cuenta
    x={escenario.ancho / 2}
    y={escenario.alto / 2}
    text-anchor="middle"
    dominant-baseline="central"
    font-size="24"
    class="fill-white stroke-tinta font-display font-black"
    stroke-width="1.2"
    paint-order="stroke"
    stroke-linejoin="round"
    visibility="hidden"></text>
</g>
